<DMSchema schemaName="Construction" alias="constr" version="01.00.04" xmlns="http://www.szewec.com/schemas/Szewec.DMXML.3.2" description="Base schema for the Construction domain.">
    <DMSchemaReference name="BisCore" version="01.00.06" alias="bis" />
    <DMSchemaReference name="CoreCustomAttributes" version="01.00.03" alias="CoreCA"/>
    <DMSchemaReference name="BisCustomAttributes" version="01.00.00" alias="bisCA"/>
    <DMSchemaReference name="DMDbMap" version="02.00.00" alias="dmdbmap"/>
    <DMSchemaReference name="Formats" version="01.00.00" alias="f"/>
    <DMSchemaReference name="Units" version="01.00.01" alias="u"/>

    <DMCustomAttributes>
        <ProductionStatus xmlns="CoreCustomAttributes.01.00.03">
            <SupportedUse>NotForProduction</SupportedUse>
        </ProductionStatus>
        <SchemaLayerInfo xmlns="BisCustomAttributes.01.00.00">
            <Value>DisciplinePhysical</Value>
        </SchemaLayerInfo>
    </DMCustomAttributes>

    <KindOfQuantity typeName="AREA" displayLabel="Area" persistenceUnit="u:SQ_M" presentationUnits="f:DefaultRealU(2)[u:SQ_M];f:DefaultRealU(2)[u:SQ_FT];f:DefaultRealU(2)[u:SQ_US_SURVEY_FT]" relativeError="0.0001"/>
    <KindOfQuantity typeName="STATION" displayLabel="Station" persistenceUnit="u:M" presentationUnits="f:StationZ_1000_3[u:M];f:StationZ_100_2[u:FT];f:DefaultRealU(2)[u:M];f:DefaultRealU(2)[u:FT];f:DefaultRealU(2)[u:US_SURVEY_FT]" relativeError="0.0001"/>
    <KindOfQuantity typeName="VOLUME" displayLabel="Volume" persistenceUnit="u:CUB_M" presentationUnits="f:DefaultRealU(2)[u:CUB_M];f:DefaultRealU(2)[u:CUB_FT];f:DefaultRealU(2)[u:CUB_US_SURVEY_FT]" relativeError="0.0001"/>
    <KindOfQuantity typeName="LENGTH" displayLabel="Length" persistenceUnit="u:M" presentationUnits="f:DefaultRealU(2)[u:M];f:DefaultRealU(2)[u:FT];f:DefaultRealU(2)[u:US_SURVEY_FT]" relativeError="0.0001"/>

    <DMEntityClass typeName="ConstructionInformationModel" displayLabel="Construction Information Model" description="A container for persisting constr:ConstructionItem instances.">
        <BaseClass>bis:InformationModel</BaseClass>
    </DMEntityClass>

    <DMEntityClass typeName="ConstructionInformationPartition" modifier="Sealed" displayLabel="Construction Information Partition" description="A constr:ConstructionInformationPartition element indicates that there is a construction modeling perspective within the overall information hierarchy. A constr:ConstructionInformationPartition is always parented to a bis:Subject and broken down by a constr:ConstructionInformationModel.">
        <BaseClass>bis:InformationPartitionElement</BaseClass>
    </DMEntityClass>

    <DMStructClass typeName="StationRange" displayLabel="Station Range" description="Struct to define a station range.">
        <DMProperty propertyName="StartStation" displayLabel="Start Station" typeName="double" kindOfQuantity="STATION" description="Station start point."/>
        <DMProperty propertyName="EndStation" displayLabel="End Station" typeName="double" kindOfQuantity="STATION" description="Station end point."/>
    </DMStructClass>

    <DMEntityClass typeName="ConstructionDetailingElement" displayLabel="Construction Detailing Element" description="Identifies a portion of real-world physical object that is suitable for construction.">
        <BaseClass>bis:SpatialLocationElement</BaseClass>
        <DMProperty propertyName="SlopedArea" displayLabel="Sloped Area" typeName="double" kindOfQuantity="AREA" description="Total sloped area."/>
        <DMProperty propertyName="SurfaceArea" displayLabel="Surface Area" typeName="double" kindOfQuantity="AREA" description="Total surface area."/>
        <DMProperty propertyName="Volume" displayLabel="Volume" typeName="double" kindOfQuantity="VOLUME" description="Volume of the element."/>
        <DMStructProperty propertyName="StationRange" displayLabel="Station Range" typeName="StationRange" description="Well-known location of the element defined by the station range."/>
        <DMProperty propertyName="LengthOfSlice" displayLabel="Length of Slice" typeName="double" kindOfQuantity="LENGTH" description="Length of an element produced by slice operation." />
    </DMEntityClass>

    <DMEntityClass typeName="WorkAreaDetailingElement" displayLabel="Work Area Detailing Element" description="Identifies a portion of real-world physical object that got split because it crossed construction work area boundary.">
        <BaseClass>ConstructionDetailingElement</BaseClass>
    </DMEntityClass>

    <DMRelationshipClass typeName="ConstructionDetailingElementSplitsGeometricElement3d" strength="referencing" strengthDirection="Forward" modifier="Sealed" description="Relationship enabling splitup of bis:GeometricElement3d elements into the smaller pieces.">
        <BaseClass>bis:ElementRefersToElements</BaseClass>
        <Source multiplicity="(0..*)" roleLabel="is portion of" polymorphic="true">
            <Class class="ConstructionDetailingElement"/>
        </Source>
        <Target multiplicity="(0..2)" roleLabel="is split into" polymorphic="true">
            <Class class="bis:GeometricElement3d"/>
        </Target>
    </DMRelationshipClass>

    <DMEntityClass typeName="ConstructionItem" displayLabel="Construction Item" modifier="Sealed" description="Defines a constructible component which may or may not be modeled in the 3D model.">
        <BaseClass>bis:InformationRecordElement</BaseClass>
    </DMEntityClass>

    <DMRelationshipClass typeName="ConstructionItemConstructsGeometricElement3d" strength="referencing" strengthDirection="Forward" modifier="Sealed" description="Relates constr:ConstructionItem to the real world entities (or their split up pieces modeled as constr:ConstructionDetailingElement elements) it constructs.">
        <BaseClass>bis:ElementRefersToElements</BaseClass>
        <Source multiplicity="(0..*)" roleLabel="constructs" polymorphic="false">
            <Class class="ConstructionItem"/>
        </Source>
        <Target multiplicity="(0..*)" roleLabel="is constructed by" polymorphic="true">
            <Class class="bis:GeometricElement3d"/>
        </Target>
    </DMRelationshipClass>

    <DMEntityClass typeName="ConstructionWorkArea" displayLabel="Construction Work Area" description="Represents geographically identifiable area which encompasses all disciplines that will execute work within that area.">
        <BaseClass>bis:SpatialLocationElement</BaseClass>
    </DMEntityClass>

    <DMRelationshipClass typeName="ElementBelongsToConstructionWorkArea" strength="referencing" strengthDirection="Forward" modifier="Sealed" description="Relates a bis:Element to the constr:ConstructionWorkArea that it belongs to.">
        <BaseClass>bis:ElementRefersToElements</BaseClass>
        <Source multiplicity="(0..*)" roleLabel="belongs to" polymorphic="true">
            <Class class="bis:Element"/>
        </Source>
        <Target multiplicity="(0..1)" roleLabel="is referenced" polymorphic="false">
            <Class class="ConstructionWorkArea"/>
        </Target>
    </DMRelationshipClass>

    <DMEntityClass typeName="GenericConstructionObject" modifier="Sealed" displayLabel="Construction Object" description="Represents a generic object used during construction">
        <BaseClass>bis:PhysicalElement</BaseClass>
    </DMEntityClass>

    <DMEntityClass typeName="CostCode" modifier="Sealed" displayLabel="Cost Code" description="The aspect used to store Cost Code assignments to constr:ConstructionItem elements.">
        <BaseClass>bis:ElementMultiAspect</BaseClass>
        <DMCustomAttributes>
            <DbIndexList xmlns="DMDbMap.02.00.00">
                <Indexes>
                    <DbIndex>
                        <Name>ix_constr_costcode</Name>
                        <IsUnique>True</IsUnique>
                        <Properties>
                            <string>Element.Id</string>
                            <string>CodeId</string>
                        </Properties>
                    </DbIndex>
                </Indexes>
            </DbIndexList>
        </DMCustomAttributes>
 		<DMProperty propertyName="CodeId" displayLabel="Cost Code Id" description="The Id of the Cost Code in Construction QTO service." typeName="string">
            <DMCustomAttributes>
                <HiddenProperty xmlns="CoreCustomAttributes.01.00.03"/>
            </DMCustomAttributes>
		</DMProperty>
    </DMEntityClass>

    <DMRelationshipClass typeName="ConstructionItemOwnsCostCodes" strength="embedding" strengthDirection="Forward" modifier="Sealed" description="Defines aspect's ownership.">
        <BaseClass>bis:ElementOwnsMultiAspects</BaseClass>
        <Source multiplicity="(1..1)" roleLabel="owns" polymorphic="false">
            <Class class="ConstructionItem" />
        </Source>
        <Target multiplicity="(0..*)" roleLabel="is owned by" polymorphic="false">
            <Class class="CostCode"/>
        </Target>
    </DMRelationshipClass>

    <DMEntityClass typeName="ConstructionQuantity" modifier="Sealed" displayLabel="Construction Quantity" description="The aspect used to store construction quantity data for constr:ConstructionItem elements.">
        <BaseClass>bis:ElementMultiAspect</BaseClass>
        <DMCustomAttributes>
            <DbIndexList xmlns="DMDbMap.02.00.00">
                <Indexes>
                    <DbIndex>
                        <Name>ix_constr_workstepcode</Name>
                        <IsUnique>True</IsUnique>
                        <Properties>
                            <string>Element.Id</string>
                            <string>CostCodeId</string>
                            <string>WorkStepCode</string>
                        </Properties>
                    </DbIndex>
                </Indexes>
            </DbIndexList>
        </DMCustomAttributes>
		<DMProperty propertyName="CostCodeId" displayLabel="Cost Code Id" description="The Id of the Cost Code in Construction QTO service." typeName="string">
            <DMCustomAttributes>
                <HiddenProperty xmlns="CoreCustomAttributes.01.00.03"/>
            </DMCustomAttributes>
		</DMProperty>
        <DMProperty propertyName="WorkStepCode" displayLabel="Work Step Code" typeName="string" description="Work Step Code for which the value is calculated."/>
        <DMProperty propertyName="Quantity" displayLabel="Quantity value" typeName="double" description="Calculated quantity value."/>
        <DMProperty propertyName="QuantityUnitName" displayLabel="Unit of Measure name" typeName="string" description="The fully qualified unit name (if it exists) used to persist the quantity value."/>
        <DMProperty propertyName="QuantityUnitLabel" displayLabel="Unit of Measure label" typeName="string" description="The unit display label to use when showing the quantity value."/>
        <DMProperty propertyName="JsonProperties" typeName="string" extendedTypeName="Json" displayLabel="JSON Properties" description="A string property that users and/or applications can use to persist ad hoc JSON values.">
            <DMCustomAttributes>
                <HiddenProperty xmlns="CoreCustomAttributes.01.00.03"/>
            </DMCustomAttributes>
        </DMProperty>
    </DMEntityClass>

    <DMRelationshipClass typeName="ConstructionItemOwnsConstuctionQuantities" strength="embedding" strengthDirection="Forward" modifier="Sealed" description="Defines aspect's ownership.">
        <BaseClass>bis:ElementOwnsMultiAspects</BaseClass>
        <Source multiplicity="(1..1)" roleLabel="owns" polymorphic="false">
            <Class class="ConstructionItem" />
        </Source>
        <Target multiplicity="(0..*)" roleLabel="is owned by" polymorphic="false">
            <Class class="ConstructionQuantity"/>
        </Target>
    </DMRelationshipClass>
    
</DMSchema>