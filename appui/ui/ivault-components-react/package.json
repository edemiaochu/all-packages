{
  "name": "@szewtwin/ivault-components-react",
  "version": "5.26.0",
  "description": "A react component library of szewTwin.js UI iVault components",
  "type": "module",
  "types": "./lib/ivault-components-react.d.ts",
  "exports": {
    ".": "./lib/ivault-components-react.js",
    "./internal": "./lib/internal.js",
    "./package.json": "./package.json",
    "./lib/cjs/*": {
      "sass": "./lib/*"
    },
    "./lib/esm/*": {
      "sass": "./lib/*"
    },
    "./*": {
      "sass": "./*"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szewTwin/appui.git",
    "directory": "ui/ivault-components-react"
  },
  "scripts": {
    "start": "run-p -l \"build -- -w\" \"copy:** -- -w\"",
    "build": "npm run copy:css && npm run compat:css && npm run copy:locale && tsc",
    "copy:css": "cpx \"./src/**/*.*css\" ./lib",
    "copy:locale": "cpx ./src/ivault-components-react/UiIVaultComponents.json ./lib/public/locales/en",
    "compat:css": "npm run compat:cjs && npm run compat:esm",
    "compat:cjs": "cpx \"./src/**/*.{*css,svg}\" ./lib/cjs",
    "compat:esm": "cpx \"./src/**/*.{*css,svg}\" ./lib/esm",
    "clean": "rimraf -g lib",
    "cover": "vitest run --coverage",
    "lint": "eslint \"./src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run -s lint -- --fix",
    "extract-api": "betools extract-api --entry=./lib/ivault-components-react --apiReportFolder=../../common/api --apiReportTempFolder=../../common/temp/api --apiSummaryFolder=../../common/api/summary",
    "test": "vitest",
    "docs": "npm run -s docs:reference && npm run -s docs:changelog",
    "docs:changelog": "cpx ./CHANGELOG.md ../../generated-docs/reference/ivault-components-react",
    "docs:reference": "cross-env NODE_PROJECT_ROOT_DIRECTORY=../../ betools docs --includes=../../generated-docs/extract --json=../../generated-docs/reference/ivault-components-react/file.json --tsIndexFile=./ivault-components-react.ts --onlyJson"
  },
  "keywords": [
    "AppUI",
    "Szewec",
    "BIM",
    "iVault"
  ],
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "peerDependencies": {
    "@szewtwin/appui-abstract": "^4.0.0 || ^5.0.0",
    "@szewtwin/components-react": "workspace:*",
    "@szewtwin/core-szewec": "^4.0.0 || ^5.0.0",
    "@szewtwin/core-common": "^4.0.0 || ^5.0.0",
    "@szewtwin/core-frontend": "^4.0.0 || ^5.0.0",
    "@szewtwin/core-geometry": "^4.0.0 || ^5.0.0",
    "@szewtwin/core-quantity": "^4.0.0 || ^5.0.0",
    "@szewtwin/core-react": "workspace:*",
    "@szewtwin/szewtwinui-react": "^3.15.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@szewtwin/appui-abstract": "catalog:",
    "@szewtwin/build-tools": "catalog:",
    "@szewtwin/components-react": "workspace:*",
    "@szewtwin/core-szewec": "catalog:",
    "@szewtwin/core-common": "catalog:",
    "@szewtwin/core-frontend": "catalog:",
    "@szewtwin/core-geometry": "catalog:",
    "@szewtwin/core-orbitgt": "catalog:",
    "@szewtwin/core-quantity": "catalog:",
    "@szewtwin/core-react": "workspace:*",
    "@szewtwin/dmschema-metadata": "catalog:",
    "@szewtwin/eslint-plugin": "catalog:",
    "@szewtwin/szewtwinui-react": "catalog:",
    "@szewtwin/webgl-compatibility": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^3.0.6",
    "cpx2": "^3.0.0",
    "cross-env": "^5.1.4",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "ignore-styles": "^5.0.1",
    "inversify": "^6.0.1",
    "jsdom": "^24.0.0",
    "npm-run-all": "^4.1.5",
    "raf": "^3.4.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "^0.1.13",
    "rimraf": "catalog:",
    "typemoq": "^2.1.0",
    "typescript": "~5.6.2",
    "upath": "^2.0.1",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@szewtwin/szewtwinui-icons-react": "^2.8.0",
    "classnames": "2.5.1",
    "ts-key-enum": "~2.0.12"
  }
}
