      "tag": "@szewtwin/ivault-browser-react_v0.11.0",
      "date": "Fri, 06 Aug 2021 13:03:18 GMT",
      "comments": {
        "minor": [
          {
            "comment": "iVaults API change: property `state` replaces `initialized`\n"
          },
          {
            "comment": "BREAKING: IVaultGrid only support rest API features to reduce complexity; Now only supports `sortOptions` with `sortType: 'name'` (function or other types no longer available), removed `assetId`, `filterOptions`, `iVaultOptions` (previously replaced by `iVaultActions`)"
          },
          {
            "comment": "IVaultGrid will now fetch all iVaults with infinite scrolling (previously only top 100)"
          },
          {
            "comment": "BREAKING: ProjectGrid only support rest API features to reduce complexity; Now only supports `filterOptions` with a string (function no longer available), removed `sortOptions`, `projectOptions` (previously replaced by `projectActions`)"
          },
          {
            "comment": "ProjectGrid will now fetch all projects with infinite scrolling (previously only top 100)"
          }
        ]
      }
    },
