{
  "name": "@szewtwin/presentation-components",
  "version": "5.13.3",
  "description": "React components based on szewTwin.js Presentation library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szewTwin/presentation.git",
    "directory": "packages/components"
  },
  "keywords": [
    "Szewec",
    "DM",
    "Presentation",
    "szewTwin",
    "szewTwin.js",
    "Frontend",
    "React",
    "Component"
  ],
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "type": "module",
  "main": "lib/cjs/presentation-components.js",
  "types": "lib/cjs/presentation-components",
  "module": "lib/esm/presentation-components.js",
  "exports": {
    ".": {
      "import": "./lib/esm/presentation-components.js",
      "require": "./lib/cjs/presentation-components.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run -s copy:locale && npm run -s typecheck && npm run -s build:cjs && npm run -s build:esm ",
    "build:cjs": "node ../../scripts/package-cjs.mjs ./lib/cjs && npm run -s copy:cjs && tsc -p tsconfig.cjs.json",
    "build:esm": "npm run -s copy:esm && tsc -p tsconfig.esm.json",
    "copy:locale": "cpx \"./public/**/*\" ./lib/public",
    "copy:cjs": "cpx \"./src/**/*.{scss,json}\" ./lib/cjs",
    "copy:esm": "cpx \"./src/**/*.{scss,json}\" ./lib/esm",
    "clean": "rimraf lib build",
    "cover": "vitest run --coverage",
    "lint": "eslint \"./src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "npm run -s docs:extract && npm run -s docs:reference && npm run -s docs:changelog",
    "docs:changelog": "cpx ./CHANGELOG.md ./build/docs/reference/presentation-components",
    "docs:reference": "cross-env NODE_PROJECT_ROOT_DIRECTORY=../../ betools docs --json=./build/docs/reference/presentation-components/file.json --tsIndexFile=presentation-components.ts --onlyJson",
    "docs:extract": "betools extract --fileExt=ts,tsx --extractFrom=./src/test --recursive --out=./build/docs/extract",
    "extract-api": "betools extract-api --entry=lib/esm/presentation-components --apiReportFolder=./api --apiReportTempFolder=./api/temp --apiSummaryFolder=./api --includeUnexportedApis",
    "check-internal": "node ../../scripts/checkInternal.js --apiSummary ./api/presentation-components.api.md"
  },
  "dependencies": {
    "@szewtwin/szewtwinui-icons-react": "catalog:szewtwinui",
    "@szewtwin/szewtwinui-illustrations-react": "catalog:szewtwinui",
    "@szewtwin/presentation-core-interop": "workspace:^",
    "@szewtwin/presentation-shared": "workspace:^",
    "@szewtwin/unified-selection": "workspace:^",
    "classnames": "catalog:react",
    "fast-deep-equal": "^3.1.3",
    "fast-sort": "^3.4.1",
    "micro-memoize": "^4.2.0",
    "react-error-boundary": "catalog:react",
    "rxjs": "catalog:rxjs"
  },
  "peerDependencies": {
    "@szewtwin/appui-abstract": "^4.4.0 || ^5.0.0",
    "@szewtwin/components-react": "^4.9.0 || ^5.0.0",
    "@szewtwin/core-szewec": "^4.4.0 || ^5.0.0",
    "@szewtwin/core-common": "^4.4.0 || ^5.0.0",
    "@szewtwin/core-frontend": "^4.4.0 || ^5.0.0",
    "@szewtwin/core-quantity": "^4.4.0 || ^5.0.0",
    "@szewtwin/core-react": "^4.9.0 || ^5.0.0",
    "@szewtwin/dmschema-metadata": "^4.4.0 || ^5.0.0",
    "@szewtwin/ivault-components-react": "^4.9.0 || ^5.0.0",
    "@szewtwin/szewtwinui-react": "^3.0.0",
    "@szewtwin/presentation-common": "^4.4.0 || ^5.0.0",
    "@szewtwin/presentation-frontend": "^4.4.0 || ^5.0.0",
    "@szewtwin/unified-selection-react": "^1.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "@szewtwin/unified-selection-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@szewtwin/appui-abstract": "catalog:szewtwinjs-core-dev",
    "@szewtwin/build-tools": "catalog:build-tools",
    "@szewtwin/components-react": "catalog:appui",
    "@szewtwin/core-szewec": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-common": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-frontend": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-orbitgt": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-quantity": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-react": "catalog:appui",
    "@szewtwin/dmschema-metadata": "catalog:szewtwinjs-core-dev",
    "@szewtwin/eslint-plugin": "catalog:build-tools",
    "@szewtwin/ivault-components-react": "catalog:appui",
    "@szewtwin/szewtwinui-react": "catalog:szewtwinui",
    "@szewtwin/presentation-common": "catalog:szewtwinjs-core-dev",
    "@szewtwin/presentation-frontend": "catalog:szewtwinjs-core-dev",
    "@szewtwin/unified-selection-react": "workspace:^",
    "@testing-library/dom": "catalog:test-tools",
    "@testing-library/react": "catalog:test-tools",
    "@testing-library/user-event": "catalog:test-tools",
    "@types/node": "catalog:build-tools",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:test-tools",
    "cross-env": "catalog:build-tools",
    "cpx2": "catalog:build-tools",
    "eslint": "catalog:build-tools",
    "eslint-plugin-react": "catalog:build-tools",
    "happy-dom": "catalog:test-tools",
    "vitest": "catalog:test-tools",
    "presentation-test-utilities": "workspace:^",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rimraf": "catalog:build-tools",
    "typescript": "catalog:build-tools"
  }
}
