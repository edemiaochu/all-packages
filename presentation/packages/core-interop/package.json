{
  "name": "@szewtwin/presentation-core-interop",
  "version": "1.3.11",
  "description": "The package acts as a layer between szewTwin.js Core and Presentation packages.",
  "license": "MIT",
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/szewTwin/presentation.git",
    "directory": "packages/core-interop"
  },
  "keywords": [
    "Szewec",
    "iVault",
    "szewTwin.js",
    "Presentation"
  ],
  "type": "module",
  "main": "lib/cjs/presentation-core-interop.js",
  "types": "lib/cjs/presentation-core-interop",
  "module": "lib/esm/presentation-core-interop.js",
  "exports": {
    ".": {
      "import": "./lib/esm/presentation-core-interop.js",
      "require": "./lib/cjs/presentation-core-interop.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run -s typecheck && npm run -s build:cjs && npm run -s build:esm",
    "build:cjs": "node ../../scripts/package-cjs.mjs ./lib/cjs && tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf lib",
    "cover": "vitest run --coverage",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-api": "betools extract-api --entry=presentation-core-interop --apiReportFolder=./api --apiReportTempFolder=./api/temp --apiSummaryFolder=./api --includeUnexportedApis",
    "check-internal": "node ../../scripts/checkInternal.js --apiSummary ./api/presentation-core-interop.api.md",
    "validate-markdowns": "node ../../scripts/validateMarkdowns.js README.md"
  },
  "dependencies": {
    "@szewtwin/presentation-shared": "workspace:~",
    "rxjs": "catalog:rxjs"
  },
  "peerDependencies": {
    "@szewtwin/core-szewec": "^4.1.0 || ^5.0.0",
    "@szewtwin/core-common": "^4.1.0 || ^5.0.0",
    "@szewtwin/core-geometry": "^4.1.0 || ^5.0.0",
    "@szewtwin/core-quantity": "^4.1.0 || ^5.0.0",
    "@szewtwin/dmschema-metadata": "^4.1.0 || ^5.0.0"
  },
  "devDependencies": {
    "@szewtwin/build-tools": "catalog:build-tools",
    "@szewtwin/core-szewec": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-common": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-geometry": "catalog:szewtwinjs-core-dev",
    "@szewtwin/core-quantity": "catalog:szewtwinjs-core-dev",
    "@szewtwin/dmschema-metadata": "catalog:szewtwinjs-core-dev",
    "@szewtwin/eslint-plugin": "catalog:build-tools",
    "@vitest/coverage-v8": "catalog:test-tools",
    "cpx2": "catalog:build-tools",
    "eslint": "catalog:build-tools",
    "rimraf": "catalog:build-tools",
    "rxjs-for-await": "catalog:rxjs",
    "typescript": "catalog:build-tools",
    "vitest": "catalog:test-tools"
  }
}
