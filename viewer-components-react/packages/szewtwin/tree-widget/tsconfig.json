{
  "extends": "./node_modules/@szewtwin/build-tools/tsconfig-base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noImplicitOverride": false,
    "resolveJsonModule": true,
    "lib": ["DOM"]
