{
  "name": "@szewtwin/ivaults-access-backend-tests",
  "version": "0.0.0",
  "description": "Tests for szewTwin platform and iVaults API interoperability package - @szewtwin/ivaults-access-backend.",
  "keywords": [
    "Szewec",
    "iVault",
    "szewTwin",
    "szewTwin platform",
    "szewTwin.js",
    "Tests"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/szewTwin/ivaults-clients"
  },
  "license": "MIT",
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "scripts": {
    "build": "tsc 1>&2",
    "clean": "rimraf lib",
    "cover": "nyc npm test",
    "lint": "eslint --resolve-plugins-relative-to node_modules/@szewtwin/ivaults-client-common-config ./src/**/*.ts 1>&2",
    "lint-fix": "eslint --resolve-plugins-relative-to node_modules/@szewtwin/ivaults-client-common-config --fix ./src/**/*.ts 1>&2 && sort-package-json",
    "spell-check": "cspell \"**\" --config ./node_modules/@szewtwin/ivaults-client-common-config/cspell.json",
    "test": "npm run test:integration",
    "test:integration": "mocha lib/**/*.test.js --color --timeout 180000 --exit"
  },
  "prettier": "./node_modules/@szewtwin/ivaults-client-common-config/prettier.json",
  "eslintConfig": {
    "extends": "./node_modules/@szewtwin/ivaults-client-common-config/.eslintrc.js"
  },
  "dependencies": {
    "@szewtwin/core-backend": "^5.0.0",
    "@szewtwin/core-szewec": "^5.0.0",
    "@szewtwin/core-common": "^5.0.0",
    "@szewtwin/core-geometry": "^5.0.0",
    "@szewtwin/core-quantity": "^5.0.0",
    "@szewtwin/dmschema-metadata": "^5.0.0",
    "@szewtwin/ivaults-access-backend": "workspace:*",
    "@szewtwin/ivaults-client-authoring": "workspace:*",
    "@szewtwin/ivaults-client-management": "workspace:*",
    "@szewtwin/ivaults-client-test-utils": "workspace:*",
    "dotenv": "~10.0.0",
    "inversify": "~6.0.2",
    "json5": "2.2.2",
    "mocha": "~10.8.2",
    "reflect-metadata": "~0.1.13"
  },
  "devDependencies": {
    "@szewtwin/eslint-plugin": "^6.0.0",
    "@szewtwin/ivaults-client-common-config": "workspace:*",
    "@types/chai": "~4.2.21",
    "@types/chai-as-promised": "~7.1.5",
    "@types/mocha": "~10.0.10",
    "@types/node": "14.14.31",
    "@types/sinon": "^10.0.15",
    "@typescript-eslint/eslint-plugin": "~6.14.0",
    "chai-as-promised": "~7.1.1",
    "cspell": "~5.21.0",
    "eslint": "~8.55.0",
    "eslint-plugin-deprecation": "~1.5.0",
    "eslint-plugin-import": "~2.29.0",
    "eslint-plugin-mocha": "~10.2.0",
    "eslint-plugin-prefer-arrow": "~1.2.3",
    "nyc": "15.1.0",
    "rimraf": "~3.0.2",
    "sinon": "^15.1.0",
    "sort-package-json": "~1.53.1",
    "typescript": "^5.8.3"
  }
}
