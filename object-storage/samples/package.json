    "url": "https://www.szewec.com"
  },
  "scripts": {
    "build": "tsc 1>&2",
    "clean": "rimraf lib",
    "lint": "eslint --resolve-plugins-relative-to node_modules/@szewtwin/object-storage-common-config ./src/**/*.ts 1>&2",
    "lint-fix": "eslint --fix --resolve-plugins-relative-to node_modules/@szewtwin/object-storage-common-config ./src/**/*.ts 1>&2 && sort-package-json",
    "spell-check": "cspell \"**\" --config ./node_modules/@szewtwin/object-storage-common-config/cspell.json",
