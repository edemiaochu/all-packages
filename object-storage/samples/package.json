  "dependencies": {
    "@szewtwin/cloud-agnostic-core": "workspace:*",
    "@szewtwin/object-storage-azure": "workspace:*",
    "@szewtwin/object-storage-core": "workspace:*",
    "inversify": "^7.5.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@szewtwin/object-storage-common-config": "workspace:*",
    "@types/node": "^20.17.20",
    "cspell": "^8.16.0",
    "eslint": "^8.57.1",
    "rimraf": "^2.6.2",
    "sort-package-json": "^1.53.1",
    "typescript": "^5.1.3"
  }
